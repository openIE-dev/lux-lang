# Lux component tour: composition, props, slots, scoped styles, and
# if/for inside view blocks.
#
# Run:   lux run Tour.lux
# Build: lux build Tour.lux --target html     (or --target wasm)

# A module-level style: global, usable from any view as `@page`.
style page:
    max_width = "560px"
    margin = "40px auto"
    font_family = "system-ui, sans-serif"
    color = "#111827"

# ── Badge ─────────────────────────────────────────────────────────
# A leaf component with two props. `if`/`else` in the view picks the
# element; the `style` blocks below are scoped to Badge.
component Badge(label, tone):
    view:
        if tone == "done":
            span @badge_done "{label}"
        else:
            span @badge "{label}"

    style badge:
        font_size = "12px"
        padding = "2px 8px"
        border_radius = "999px"
        background = "#fef3c7"
        color = "#92400e"

    style badge_done:
        font_size = "12px"
        padding = "2px 8px"
        border_radius = "999px"
        background = "#dcfce7"
        color = "#166534"

# ── Card ──────────────────────────────────────────────────────────
# A layout component: whatever the caller nests under `Card ...:` renders
# where `slot` sits.
component Card(title):
    view:
        section @card:
            h2 @card_title "{title}"
            slot

    style card:
        border = "1px solid #e5e7eb"
        border_radius = "12px"
        padding = "16px 20px"
        margin_bottom = "16px"

    style card_title:
        font_size = "14px"
        text_transform = "uppercase"
        letter_spacing = "0.05em"
        color = "#6b7280"
        margin = "0 0 12px"

# ── TaskRow ───────────────────────────────────────────────────────
# Composition: TaskRow renders a Badge, passing values derived from its
# own props.
component TaskRow(name, done):
    view:
        div @row:
            span @row_name "{name}"
            if done:
                Badge label="done" tone="done"
            else:
                Badge label="open" tone="open"

    style row:
        display = "flex"
        justify_content = "space-between"
        align_items = "center"
        padding = "6px 0"

    style row_name:
        font_size = "15px"

# ── App ───────────────────────────────────────────────────────────
app Tour:
    let tasks = [
        {name: "Write the parser", done: true},
        {name: "Lower to flowG", done: true},
        {name: "Ship the component tour", done: false}
    ]
    let mut show_done = signal(true)

    view:
        div @page:
            h1 "Lux component tour"

            # `for` renders one TaskRow per task; the `if` filters on a signal.
            Card title="Tasks":
                for task in tasks:
                    if show_done or not task.done:
                        TaskRow name=task.name done=task.done

            Card title="Controls":
                button "Toggle done tasks" on:click -> show_done = not show_done
                p "Showing done tasks: {show_done}"

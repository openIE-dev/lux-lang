# Lux reactive counter: signal-driven state; the buttons update it and the
# heading re-renders.
#
# Run:   lux run Counter.lux
# Build: lux build Counter.lux --target html -o counter.html

app Counter:
    let mut count = signal(0)

    view:
        column:
            h2 "Count: {count}"
            button "Increment" on:click -> count = count + 1
            button "Reset" on:click -> count = 0
